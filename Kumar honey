package com.tipcalculator;

import java.math.BigDecimal;
import java.math.RoundingMode;
import java.text.NumberFormat;
import javafx.beans.value.ChangeListener;
import javafx.beans.value.ObservableValue;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.Slider;
import javafx.scene.control.TextField;

public class TipController {

    private final TextField billTextField;
    private final Slider tipSlider;
    private final Label percentageLabel;
    private final TextField tipTextField;
    private final TextField totalTextField;

    private static final NumberFormat currencyFormat = NumberFormat.getCurrencyInstance();
    private static final NumberFormat percentFormat = NumberFormat.getPercentInstance();

    public TipController(TextField billTextField, Slider tipSlider, Label percentageLabel, TextField tipTextField, TextField totalTextField) {
        this.billTextField = billTextField;
        this.tipSlider = tipSlider;
        this.percentageLabel = percentageLabel;
        this.tipTextField = tipTextField;
        this.totalTextField = totalTextField;
    }

    public void attachListeners(Button calculateButton) {
        // 1. Real-time Slider Property Listener: Updates the label as the slider thumb moves
        tipSlider.valueProperty().addListener(new ChangeListener<Number>() {
            @Override
            public void changed(ObservableValue<? extends Number> observable, Number oldValue, Number newValue) {
                // Round the slider value to an integer percentage
                int percentInt = newValue.intValue();
                percentageLabel.setText(percentInt + "%");
            }
        });

        // 2. Action Event Handler: Performs mathematical calculations when clicking the button
        calculateButton.setOnAction(event -> {
            try {
                // Extract amount and parse using BigDecimal for precise currency math
                String amountText = billTextField.getText().trim();
                if (amountText.isEmpty()) return;

                BigDecimal amount = new BigDecimal(amountText);
                
                // Get slider percentage rate
                BigDecimal tipRate = BigDecimal.valueOf((int) tipSlider.getValue()).divide(BigDecimal.valueOf(100));
                
                // Perform calculations
                BigDecimal tip = amount.multiply(tipRate).setScale(2, RoundingMode.HALF_UP);
                BigDecimal total = amount.add(tip).setScale(2, RoundingMode.HALF_UP);

                // Populate output fields formatted as localized currency
                tipTextField.setText(currencyFormat.format(tip));
                totalTextField.setText(currencyFormat.format(total));
                
            } catch (NumberFormatException ex) {
                // Handle invalid inputs (e.g., text instead of numbers) gently
                billTextField.setText("Invalid Input");
                billTextField.selectAll();
                billTextField.requestFocus();
            }
        });
    }
}         8.3
